# OpenRouter (chat / VIP card AI)
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=
VITE_OPENROUTER_MODEL_FALLBACK=

# Optional override; default live Payment Link is in src/lib/stripe-checkout.ts (STRIPE_PAYMENT_LINK)
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/7sY4gy1AH48q21X2hQ2Ji01
# Optional Stripe Customer Portal login link (prefilled_email added automatically when logged in)
# VITE_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/...
# Supabase Storage: run supabase/storage_avatars.sql + supabase/profiles.sql in SQL Editor

# Supabase Auth (Email + Password, Google OAuth)
# Optional: run supabase/vip_members.sql for server-side VIP by email (Stripe webhook). Without it, VIP uses local email-bound proof after checkout.
# Enable Google under Supabase Dashboard → Authentication → Providers → Google
# Use Project URL + publishable/anon key from Supabase Dashboard → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public app URL for auth redirects (add https://YOUR_DOMAIN/auth/callback in Supabase → Auth → URL config)
# VITE_APP_URL=https://mind-bestie-znvt.vercel.app
# Optional alias (same value as anon/publishable key)
# VITE_SUPABASE_PUBLISHABLE_KEY=
