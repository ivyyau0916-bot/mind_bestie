# OpenRouter (chat / VIP card AI)
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=
VITE_OPENROUTER_MODEL_FALLBACK=

# Optional override; default test link is in src/lib/stripe-checkout.ts (STRIPE_PAYMENT_LINK)
VITE_STRIPE_PAYMENT_LINK=

# Supabase Auth (Google + Magic Link) & VIP email lookup (vip_members table)
# Use Project URL + publishable/anon key from Supabase Dashboard → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias (same value as anon/publishable key)
# VITE_SUPABASE_PUBLISHABLE_KEY=
